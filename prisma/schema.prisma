// -----------------------------------------------------------------------------
// 《通用文学知识图谱系统》核心数据库定义
// -----------------------------------------------------------------------------
// 版本 v5（2026-08-07）：分析架构重构，扩展知识统一 Skill 化。
// - 通用实体 + 事实模型：entities 合表 + 单一 facts 表（证据锚定）+ relationships 物化聚合
// - 所有扩展知识 Skill 化：skills / skill_versions
// - Agent 运行全留痕：agent_runs / agent_write_audits
// - 旧分析模型（Persona/Profile/BiographyRecord/AliasMapping/
//   PromptTemplate/GenericTitleRule/ExtractionRule/BookType/RelationshipType/
//   KnowledgeAuditLog 等）已删除

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- 枚举定义 (业务逻辑分类) ---

enum NameType {
  NAMED // 有名有姓（默认）
  TITLE_ONLY // 仅有称号/官职/绰号，无名字

  @@map("name_type")
}

enum RecordSource {
  AI // AI 解析产出（默认）
  MANUAL // 用户手动录入
  DRAFT_AI // AI 待审稿，需通过审核才能升级为 AI 或 MANUAL
  AUTO_VERIFIED // 自动接受栈落库（机器验收通过），区别于 MANUAL 人工确认

  @@map("record_source")
}

enum AppRole {
  ADMIN // 管理员：拥有系统配置与审核权限
  VIEWER // 只读用户：仅可查看数据

  @@map("app_role")
}

enum ProcessingStatus {
  DRAFT // AI 初步提取，待人工审核
  VERIFIED // 已人工核准，正式入库
  REJECTED // 噪音数据或错误识别

  @@map("processing_status")
}

enum AnalysisJobStatus {
  QUEUED // 已入队，等待调度
  RUNNING // 执行中
  SUCCEEDED // 执行成功
  FAILED // 执行失败
  CANCELED // 人工或系统取消

  @@map("analysis_job_status")
}

enum AliasType {
  TITLE // 封号/尊号，如太祖皇帝、吴王
  POSITION // 职位称呼，如丞相、知府
  KINSHIP // 亲属代称，如皇后、世子
  NICKNAME // 绰号/外号，如范老爷
  COURTESY_NAME // 字号，如子美

  @@map("alias_type")
}

/// 别名注册审核状态（原 AliasMappingStatus 泛化）
enum AliasStatus {
  PENDING // 待确认
  CONFIRMED // 已确认
  LLM_INFERRED // AI 仲裁推断，待后续验证升级
  REJECTED // 已拒绝

  @@map("alias_status")
}

/// 统一实体类型（原 PersonaType 泛化，新增类型不改表结构）
enum EntityType {
  PERSON // 人物
  LOCATION // 地点（州县、官署、名胜）
  ORGANIZATION // 组织（家族、帮派、学院）
  CONCEPT // 关键概念/物件（如：严监生的两根灯草）

  @@map("entity_type")
}

/// 泛型事实判别器
enum FactType {
  BIOGRAPHY // 传记/生平事件（人物为主语）
  RELATION // 关系事实（双端实体 + relationshipTypeCode）
  ITEM_TRANSFER // 物品流转（谁→谁 的物件）
  ORGANIZATION_EVENT // 组织/团体事件
  GENERIC // 其它（扩展用，不改表）

  @@map("fact_type")
}

/// 传记事件分类（原 BioCategory，值不变）
enum EventCategory {
  BIRTH // 出生
  EXAM // 科举/晋升（中举、落第、授职）
  CAREER // 官职变动/职业生涯（升迁、罢官、调任）
  TRAVEL // 游历/搬迁（进京、返乡）
  SOCIAL // 重大社交（寿宴、雅集、结盟）
  DEATH // 卒
  EVENT // 普通重要情节

  @@map("event_category")
}

enum ChapterType {
  /**
   * 楔子/序幕：通常是总纲性质的章节，概括全书大义，介绍主要人物和背景。
   */
  PRELUDE // 楔子 / 序幕
  /**
   * 正文回目：书籍的核心章节，按照时间顺序展开故事情节和人物关系。
   */
  CHAPTER // 正文回目
  /**
   * 后记/尾声：总结全书内容，回顾人物命运，或提供作者的反思和评论。
   */
  POSTLUDE // 后记 / 尾声

  @@map("chapter_type")
}

/// Skill 主分类（管理 UI 分组；content.knowledge 可混合多类）
enum SkillCategory {
  SURNAME // 姓氏
  GENERIC_TITLE // 泛称
  NAME_PATTERN // 名字模式
  RELATIONSHIP_TYPE // 关系类型
  HISTORICAL_FIGURE // 历史人物
  TASK_INSTRUCTION // 任务指令
  HYBRID // 混合

  @@map("skill_category")
}

enum SkillSource {
  MANUAL // 管理员手工维护
  GENERATED // 由 SkillGenerator 生成
  AI // AI 辅助创建

  @@map("skill_source")
}

enum SkillStatus {
  DRAFT // 草稿（生成器产出，待审核）
  ACTIVE // 启用
  DISABLED // 停用
  ARCHIVED // 归档

  @@map("skill_status")
}

/// Agent 运行类型（v5：无工具循环，一次 run 对应管线一个确定性阶段）
enum AgentRunType {
  PRESCAN // 确定性预扫描
  IDENTITY // 身份解析（Tier1/Tier2 + reconcile）
  EXTRACTION // 分片事实提取
  RECONCILE // 漏网高频补判
  VALIDATION // 确定性校验（零 LLM）
  CROSS_VALIDATION // 跨模型复核
  SKILL_GENERATION // 技能候选生成

  @@map("agent_run_type")
}

// --- 核心模型 ---

/// @db.remark: 系统用户。仅存 admin / viewer 账号，初始管理员由 seed 从 env 写入。
model User {
  id          String    @id @default(uuid()) @db.Uuid // 用户主键
  username    String    @unique // 系统内用户名/标识（唯一），不作为主登录凭证
  email       String    @unique // 登录邮箱（唯一）
  name        String    @default("管理员") // 展示名
  password    String    @map("password") // Argon2id 密码哈希，不存明文
  role        AppRole   @default(VIEWER) // 系统角色
  isActive    Boolean   @default(true) @map("is_active") // 账号启用状态
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6) // 最近登录时间
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6) // 更新时间

  @@index([isActive], map: "users_is_active_idx") // 账号启用状态筛选索引
  @@map("users")
}

/// @db.remark: AI 模型配置表。存储各模型的 Key、BaseURL 及启用状态，由设置页管理。
model AiModel {
  id        String  @id @default(uuid()) @db.Uuid // 模型配置主键
  provider  String // 供应商显示/分组名，可由管理员自定义
  protocol  String  @default("openai-compatible") // 调用协议: openai-compatible | gemini | embedding
  name      String // 显示名称，如 "DeepSeek V3"
  modelId   String  @map("model_id") // 供应商 API 调用标识，如 "deepseek-chat"
  aliasKey  String? @map("alias_key") // 语义别名键（用于阶段推荐与版本平滑升级）
  baseUrl   String  @map("base_url") // 可自定义，支持私有部署
  apiKey    String? @map("api_key") // 前端只展示脱敏版
  isEnabled Boolean @default(false) @map("is_enabled") // Key 配置后才可启用
  isDefault Boolean @default(false) @map("is_default") // 导入向导默认选中

  // 能力声明（管理员勾选）：用于 UI 决定是否暴露阶段级 thinking / webSearch / tools 开关，
  // 并在 provider 客户端按各家协议下发对应参数；默认 false。
  supportsThinking  Boolean @default(false) @map("supports_thinking")
  supportsWebSearch Boolean @default(false) @map("supports_web_search")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // 更新时间

  phaseLogs    AnalysisPhaseLog[] // 阶段调用日志
  agentRuns    AgentRun[] // agent 运行记录

  @@unique([provider, modelId, baseUrl], map: "ai_models_unique_endpoint")
  @@unique([aliasKey], map: "ai_models_alias_key_uniq")
  @@index([provider, isEnabled], map: "ai_models_provider_enabled_idx")
  @@map("ai_models")
}

/// @db.remark: 书籍/作品库。系统的顶层容器，支持跨作品的人物对比。
model Book {
  id             String    @id @default(uuid()) @db.Uuid // 书籍主键
  title          String // 书名，如《儒林外史》
  author         String? // 作者，如"吴敬梓"
  dynasty        String? // 背景朝代
  description    String?   @db.Text // 作品简介
  coverUrl       String?   @map("cover_url") // 3D 看板所需的封面图
  sourceFileKey  String?   @map("source_file_key") // 原始导入文件的对象存储 key
  sourceFileUrl  String?   @map("source_file_url") // 原始导入文件的可访问链接
  sourceFileName String?   @map("source_file_name") // 用户上传时的原始文件名
  sourceFileMime String?   @map("source_file_mime") // 原始文件 MIME 类型
  sourceFileSize Int?      @map("source_file_size") // 原始文件字节数
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除时间
  // PENDING (初始), PROCESSING (解析中), COMPLETED (完成), ERROR (失败)
  status         String    @default("PENDING") // 当前处理状态
  errorLog       String?   @map("error_log") @db.Text // 最近失败日志

  chapters                      Chapter[] // 章节列表
  entityProfiles                EntityProfile[] // 本书实体档案
  facts                         Fact[] // 本书事实
  relationships                 Relationship[] // 书级关系（物化聚合）
  aliases                       Alias[] // 别名注册
  analysisJobs                  AnalysisJob[] // 解析任务记录
  validationReports             ValidationReport[] // 自检报告
  mergeSuggestions              MergeSuggestion[] // 实体合并建议队列
  agentRuns                     AgentRun[] // agent 运行记录
  chapterBiographyVerifications ChapterBiographyVerification[] // 章节事实校验状态

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // 更新时间

  @@index([deletedAt], map: "books_deleted_at_idx")
  @@map("books")
}

/// @db.remark: 章节/回目。时间轴的物理基石，所有事实必须挂载在回目上。
model Chapter {
  id          String      @id @default(uuid()) @db.Uuid // 章节主键
  bookId      String      @map("book_id") @db.Uuid // 所属书籍 ID
  type        ChapterType @default(CHAPTER) // 标注是楔子还是正文
  no          Int // 章节序号（第几回），决定时间轴物理排序
  unit        String      @default("回") // 称谓单位 (如: "回", "章", "节")
  noText      String?     @map("no_text") // 自定义序号显示 (如: "第一回", "序章")
  title       String // 章节名，如"范进中举"
  content     String      @db.Text // 章节原文（用于 AI 解析及前端高亮溯源）
  parseStatus String      @default("PENDING") @map("parse_status") // PENDING | PROCESSING | SUCCEEDED | FAILED

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // 更新时间

  book                    Book                           @relation(fields: [bookId], references: [id]) // 所属书籍
  mentions                Mention[] // 本章提及记录
  facts                   Fact[] // 本章事实
  phaseLogs               AnalysisPhaseLog[] // 阶段调用日志
  biographyVerifications  ChapterBiographyVerification[] // 本章事实校验状态
  firstAppearanceProfiles EntityProfile[]                @relation("ProfileFirstAppearanceChapter") // 以本章作为首次出场章节的实体档案
  relationshipFirsts      Relationship[]                 @relation("RelationshipFirstChapter") // 以本章为首次出现的关系
  relationshipLatests     Relationship[]                 @relation("RelationshipLatestChapter") // 以本章为最近出现的关系

  @@unique([bookId, type, no], map: "chapter_book_type_no_key") // 联合唯一约束
  @@map("chapters") // 数据库物理表名：复数
}

/// @db.remark: 章节事实校验状态。只表示本章 BIOGRAPHY 事实已被人工核过。
model ChapterBiographyVerification {
  id         String   @id @default(uuid()) @db.Uuid
  bookId     String   @map("book_id") @db.Uuid
  chapterId  String   @map("chapter_id") @db.Uuid
  verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz(6)
  verifiedBy String?  @map("verified_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterId], map: "chapter_bio_verifications_book_chapter_key")
  @@index([bookId], map: "chapter_bio_verifications_book_idx")
  @@map("chapter_biography_verifications")
}

// =============================================================================
// 实体域：统一实体 + 书级档案 + 别名 + 提及
// =============================================================================

/// @db.remark: 统一实体表。PERSON/LOCATION/ORGANIZATION/CONCEPT 四类合一，跨书共享。软删除。
model Entity {
  id           String       @id @default(uuid()) @db.Uuid // 实体主键
  name         String // 全局标准名（如"范进"）
  entityType   EntityType   @default(PERSON) @map("entity_type") // 实体类型
  nameType     NameType     @default(NAMED) @map("name_type") // 人名类型
  recordSource RecordSource @default(AI) @map("record_source") // 记录来源
  confidence   Float        @default(1.0) // AI 置信度 0.0-1.0，低于 0.7 标记待核对

  gender            String? // 性别
  hometown          String? // 籍贯
  globalTags        String[]  @default([]) @map("global_tags") // 全局标签，如 ["真名士", "官僚"]
  aliases           String[]  @default([]) // 别名列表（去重标量，合并时并集）
  summary           String?   @db.Text // 全局小传
  /// 被合并时指向保留实体；自建实体为空
  canonicalEntityId String?   @map("canonical_entity_id") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除时间
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6) // 更新时间

  profiles               EntityProfile[]
  mentions               Mention[]
  aliasRecords           Alias[]           @relation("AliasEntity")
  sourceFacts            Fact[]            @relation("FactSourceEntity")
  targetFacts            Fact[]            @relation("FactTargetEntity")
  sourceRelationships    Relationship[]    @relation("RelationshipSourceEntity")
  targetRelationships    Relationship[]    @relation("RelationshipTargetEntity")
  sourceMergeSuggestions MergeSuggestion[] @relation("MergeSuggestionSourceEntity")
  targetMergeSuggestions MergeSuggestion[] @relation("MergeSuggestionTargetEntity")

  @@index([name], map: "entities_name_idx")
  @@index([entityType, deletedAt], map: "entities_type_deleted_idx")
  @@index([deletedAt], map: "entities_deleted_at_idx")
  // 非 btree 索引（基线原生 SQL 建立，声明进 schema 防止被 Prisma 误删）
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "entities_name_trgm_idx")
  @@index([aliases], type: Gin, map: "entities_aliases_idx")
  @@index([globalTags], type: Gin, map: "entities_global_tags_idx")
  @@map("entities")
}

/// @db.remark: 书级实体档案（原 Profile）。entity+book 唯一，软删除。
model EntityProfile {
  id       String @id @default(uuid()) @db.Uuid // 档案主键
  entityId String @map("entity_id") @db.Uuid // 关联实体 ID
  bookId   String @map("book_id") @db.Uuid // 关联书籍 ID

  localName                String   @map("local_name") // 书中称呼：如"范老爷"
  localSummary             String?  @map("local_summary") @db.Text // AI 汇总的本书实体小传
  officialTitle            String?  @map("official_title") // 书中官职（最终职位）
  localTags                String[] @default([]) @map("local_tags") // 性格/社会角色标签，如 ["伪君子","官僚"]
  ironyIndex               Float    @default(0) @map("irony_index") // 讽刺指数 (0-10)
  firstAppearanceChapterId String?  @map("first_appearance_chapter_id") @db.Uuid // 手动维护的首次出场章节

  // 3D 视觉配置缓存：存储节点颜色、发光度、初始坐标建议等
  visualConfig Json?            @map("visual_config") // 前端可视化配置缓存
  status       ProcessingStatus @default(DRAFT) @map("status") // 审核状态
  recordSource RecordSource     @default(AI) @map("record_source") // 数据来源
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6) // 软删除时间
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6) // 更新时间

  entity                 Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  book                   Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  firstAppearanceChapter Chapter? @relation("ProfileFirstAppearanceChapter", fields: [firstAppearanceChapterId], references: [id], onDelete: SetNull)

  @@unique([entityId, bookId], map: "entity_profiles_entity_book_key") // 一实体在同一本书仅一条档案
  @@index([bookId, deletedAt], map: "entity_profiles_book_deleted_idx") // 书籍维度的有效档案筛选索引
  @@index([firstAppearanceChapterId], map: "entity_profiles_first_appearance_chapter_idx")
  @@map("entity_profiles")
}

/// @db.remark: 别名注册表（原 alias_mappings 升级）。带证据/章节窗口/审核状态。
model Alias {
  id           String       @id @default(uuid()) @db.Uuid
  entityId     String?      @map("entity_id") @db.Uuid
  bookId       String       @map("book_id") @db.Uuid
  alias        String
  aliasType    AliasType    @map("alias_type")
  resolvedName String?      @map("resolved_name")
  evidence     String?      @db.Text
  chapterStart Int?         @map("chapter_start")
  chapterEnd   Int?         @map("chapter_end")
  confidence   Float        @default(0)
  status       AliasStatus  @default(PENDING)
  recordSource RecordSource @default(DRAFT_AI) @map("record_source")
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity Entity? @relation("AliasEntity", fields: [entityId], references: [id], onDelete: SetNull)
  book   Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, alias], map: "aliases_book_alias_idx")
  @@index([bookId, entityId], map: "aliases_book_entity_idx")
  @@index([status], map: "aliases_status_idx")
  @@map("aliases")
}

/// @db.remark: 原文提及。实体预扫描 + 章节分析产出，供出现时间线/孤儿检测/RAG 锚点。
model Mention {
  id        String @id @default(uuid()) @db.Uuid // 提及主键
  entityId  String @map("entity_id") @db.Uuid // 关联实体 ID
  chapterId String @map("chapter_id") @db.Uuid // 关联章节 ID

  rawText      String           @map("raw_text") // 原文提及片段，如"那范老爷"
  paraIndex    Int?             @map("para_index") // 段落索引，用于定位原文
  recordSource RecordSource     @default(AI) @map("record_source") // 数据来源
  status       ProcessingStatus @default(DRAFT) @map("status") // 审核状态
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6) // 软删除时间
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6) // 更新时间

  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId], map: "mentions_chapter_idx")
  @@index([entityId, chapterId], map: "mentions_entity_chapter_idx")
  @@index([status], map: "mentions_status_idx")
  @@map("mentions")
}

// =============================================================================
// 事实域：单一 facts 表（证据锚定）+ 多证据锚点
// =============================================================================

/// @db.remark: 泛型事实/事件表。sourceEntityId/targetEntityId 可空，factType 判别。
/// 每条事实必带原文证据 evidence + 章节锚点 chapterId/chapterNo + 审核状态 status + recordSource。
model Fact {
  id             String   @id @default(uuid()) @db.Uuid
  bookId         String   @map("book_id") @db.Uuid
  factType       FactType @default(GENERIC) @map("fact_type")
  sourceEntityId String?  @map("source_entity_id") @db.Uuid // 主语/发起方/传出方
  targetEntityId String?  @map("target_entity_id") @db.Uuid // 宾语/接收方（可空）

  // ---- 判别列提升（供索引/聚合/时间轴） ----
  relationshipTypeCode String?        @map("relationship_type_code") @db.VarChar(120) // RELATION 事实
  eventCategory        EventCategory? @map("event_category") // BIOGRAPHY 事实
  virtualYear          String?        @map("virtual_year")
  location             String?
  title                String?
  attitudeTags         String[]       @default([]) @map("attitude_tags")

  // ---- 证据锚定（必填） ----
  evidence  String @db.Text // 原文证据
  chapterId String @map("chapter_id") @db.Uuid
  chapterNo Int    @map("chapter_no")

  /// 类型专属结构化字段（服务层按 factType 用 Zod 校验）：
  /// BIOGRAPHY: { summary?, ironyNote?, tags[] }
  /// RELATION:  { summary? }（typeCode/attitude 已提升）
  /// ITEM_TRANSFER: { itemName, quantity?, reason? }
  /// ORGANIZATION_EVENT: { summary?, orgRole? }
  /// GENERIC: { summary?, key?, value? }
  payload      Json             @db.JsonB
  confidence   Float            @default(0.7)
  recordSource RecordSource     @default(DRAFT_AI) @map("record_source")
  status       ProcessingStatus @default(DRAFT) @map("status")
  jobId        String?          @map("job_id") @db.Uuid
  agentRunId   String?          @map("agent_run_id") @db.Uuid
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy   String?          @map("reviewed_by") @db.Uuid
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  book         Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter      Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sourceEntity Entity?      @relation("FactSourceEntity", fields: [sourceEntityId], references: [id], onDelete: SetNull)
  targetEntity Entity?      @relation("FactTargetEntity", fields: [targetEntityId], references: [id], onDelete: SetNull)
  job          AnalysisJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([bookId, chapterId], map: "facts_book_chapter_idx")
  @@index([bookId, sourceEntityId], map: "facts_book_source_idx")
  @@index([bookId, targetEntityId], map: "facts_book_target_idx")
  @@index([factType, status], map: "facts_type_status_idx")
  @@index([bookId, relationshipTypeCode], map: "facts_book_reltype_idx")
  @@index([bookId, eventCategory, virtualYear], map: "facts_book_category_year_idx")
  @@index([status, recordSource, chapterId], map: "facts_review_query_idx")
  // 非 btree 索引（基线原生 SQL 建立，声明进 schema 防止被 Prisma 误删）
  @@index([payload], type: Gin, map: "facts_payload_idx")
  @@map("facts")
}

// =============================================================================
// 关系域：物化聚合表（facts 是数据权威源，本表由 refreshRelationshipsForBook 幂等重建）
// =============================================================================

/// @db.remark: 关系物化聚合表。由 RELATION 事实聚合而来（facts 是数据权威源）。
/// 唯一键 (bookId, sourceEntityId, targetEntityId, relationshipTypeCode)。
/// SYMMETRIC 类型在聚合器内规范化 source<target；status 由底层事实推导。
model Relationship {
  id                   String @id @default(uuid()) @db.Uuid
  bookId               String @map("book_id") @db.Uuid
  sourceEntityId       String @map("source_entity_id") @db.Uuid
  targetEntityId       String @map("target_entity_id") @db.Uuid
  relationshipTypeCode String @map("relationship_type_code") @db.VarChar(120)

  factCount        Int              @default(0) @map("fact_count")
  weight           Float            @default(1)
  attitudeTags     String[]         @default([]) @map("attitude_tags")
  summary          String?          @db.Text
  firstChapterId   String?          @map("first_chapter_id") @db.Uuid
  firstChapterNo   Int?             @map("first_chapter_no")
  latestChapterId  String?          @map("latest_chapter_id") @db.Uuid
  latestChapterNo  Int?             @map("latest_chapter_no")
  status           ProcessingStatus @default(DRAFT) @map("status")
  lastAggregatedAt DateTime?        @map("last_aggregated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  source        Entity   @relation("RelationshipSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Restrict)
  target        Entity   @relation("RelationshipTargetEntity", fields: [targetEntityId], references: [id], onDelete: Restrict)
  firstChapter  Chapter? @relation("RelationshipFirstChapter", fields: [firstChapterId], references: [id], onDelete: SetNull)
  latestChapter Chapter? @relation("RelationshipLatestChapter", fields: [latestChapterId], references: [id], onDelete: SetNull)

  @@unique([bookId, sourceEntityId, targetEntityId, relationshipTypeCode], map: "relationships_book_src_tgt_type_key")
  @@index([bookId, status, deletedAt], map: "relationships_book_status_deleted_idx")
  @@index([sourceEntityId, targetEntityId], map: "relationships_src_tgt_idx")
  @@index([relationshipTypeCode], map: "relationships_reltype_idx")
  @@map("relationships")
}

// =============================================================================
// Skill 域：技能包 + 版本
// =============================================================================

/// @db.remark: 技能包。承载姓氏/泛称/名字模式/关系类型/历史人物/任务指令等一切扩展知识。
model Skill {
  id                  String        @id @default(uuid()) @db.Uuid
  slug                String        @unique @db.VarChar(120)
  name                String        @db.VarChar(80)
  description         String?       @db.Text
  category            SkillCategory @default(HYBRID)
  /// GLOBAL: 全书型生效（无 book_type_skills 链接） | BOOK_TYPE: 需至少一条 book_type_skills 链接
  scope               String        @default("GLOBAL")
  status              SkillStatus   @default(DRAFT)
  source              SkillSource   @default(MANUAL)
  generatedFromJobId  String?       @map("generated_from_job_id") @db.Uuid
  generatedFromBookId String?       @map("generated_from_book_id") @db.Uuid
  sortOrder           Int           @default(0) @map("sort_order")
  isBuiltin           Boolean       @default(false) @map("is_builtin")
  isEnabled           Boolean       @default(true) @map("is_enabled") // 独立启停开关：false=全局不可用（目录不可见/AI 不可选/不装载）
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions SkillVersion[]

  @@index([category, status], map: "skills_category_status_idx")
  @@index([status, sortOrder], map: "skills_status_sort_idx")
  @@map("skills")
}

/// @db.remark: 技能版本。content 为知识/指令/触发/工具 JSON，isActive 激活机制类比旧 prompt_template_versions。
model SkillVersion {
  id         String   @id @default(uuid()) @db.Uuid
  skillId    String   @map("skill_id") @db.Uuid
  versionNo  Int      @map("version_no")
  /// MD 文档（YAML frontmatter 承载结构化 knowledge/triggers，正文承载 instructions/说明）
  content    String   @db.Text
  isActive   Boolean  @default(false) @map("is_active")
  isBaseline Boolean  @default(false) @map("is_baseline")
  changeNote String?  @map("change_note") @db.Text
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, versionNo], map: "skill_versions_skill_version_key")
  @@index([skillId, isActive], map: "skill_versions_active_idx")
  @@map("skill_versions")
}

// =============================================================================
// 运行域：任务 + Agent 全留痕
// =============================================================================

/// @db.remark: 解析任务。保留原字段，新增技能快照与 agent 运行关联。
model AnalysisJob {
  id                        String            @id @default(uuid()) @db.Uuid // 任务主键
  bookId                    String            @map("book_id") @db.Uuid // 目标书籍 ID
  status                    AnalysisJobStatus @default(QUEUED) // 任务状态
  scope                     String            @default("FULL_BOOK") // FULL_BOOK | CHAPTER_RANGE | CHAPTER_LIST
  chapterStart              Int?              @map("chapter_start") // 章节起点（范围任务）
  chapterEnd                Int?              @map("chapter_end") // 章节终点（范围任务）
  chapterIndices            Int[]             @default([]) @map("chapter_indices") // 指定章节编号列表（CHAPTER_LIST 任务）
  attempt                   Int               @default(1) // 当前重试次数
  errorLog                  String?           @map("error_log") @db.Text // 失败摘要
  overrideStrategy          String?           @map("override_strategy") // DRAFT_ONLY | ALL_DRAFTS
  keepHistory               Boolean           @default(false) @map("keep_history") // 是否保留历史草稿版本
  /// 任务启动时解析装载的 skills [{slug, versionNo}]，用于审计与复跑
  skillsSnapshot            Json?             @map("skills_snapshot") @db.JsonB
  /// 任务启动时快照的关系码 [{code,direction,category}]（同 skillsSnapshot 模式，防跑批中途改表片间漂移）
  relationshipTypesSnapshot Json?             @map("relationship_types_snapshot") @db.JsonB
  startedAt                 DateTime?         @map("started_at") @db.Timestamptz(6) // 开始时间
  finishedAt                DateTime?         @map("finished_at") @db.Timestamptz(6) // 完成时间
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt                 DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6) // 更新时间

  book              Book               @relation(fields: [bookId], references: [id])
  phaseLogs         AnalysisPhaseLog[]
  validationReports ValidationReport[] // 该任务生成的自检报告
  facts             Fact[] // 该任务产出的事实
  agentRuns         AgentRun[] // 该任务的 agent 运行

  @@index([bookId, createdAt], map: "analysis_jobs_book_created_idx")
  @@index([status, createdAt], map: "analysis_jobs_status_created_idx")
  @@map("analysis_jobs")
}

/// @db.remark: Agent 运行。v5 一次 run = 管线一个确定性阶段（身份/提取/校验等），记录 usage/成本/进度。
model AgentRun {
  id           String       @id @default(uuid()) @db.Uuid
  jobId        String?      @map("job_id") @db.Uuid
  bookId       String?      @map("book_id") @db.Uuid
  runType      AgentRunType @map("run_type")
  modelId      String?      @map("model_id") @db.Uuid
  status       String       @default("RUNNING") // QUEUED|RUNNING|SUCCEEDED|FAILED
  usage        Json?        @db.JsonB // { promptTokens, completionTokens, totalTokens }
  skillsLoaded Json?        @map("skills_loaded") @db.JsonB // [{slug, versionNo, loadedAt}]
  errorLog     String?      @map("error_log") @db.Text
  startedAt    DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?    @map("finished_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  job         AnalysisJob?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  book        Book?             @relation(fields: [bookId], references: [id], onDelete: SetNull)
  model       AiModel?          @relation(fields: [modelId], references: [id], onDelete: SetNull)
  facts       Fact[]
  writeAudits AgentWriteAudit[]

  @@index([bookId, createdAt], map: "agent_runs_book_created_idx")
  @@index([jobId], map: "agent_runs_job_idx")
  @@map("agent_runs")
}

/// @db.remark: 写操作审计。提取落库 / 审核 / 合并的写操作留痕（evidence 校验通过记录 + before/after）。
model AgentWriteAudit {
  id         String   @id @default(uuid()) @db.Uuid
  agentRunId String   @map("agent_run_id") @db.Uuid
  stepIndex  Int      @map("step_index")
  action     String // CREATE|UPDATE|DELETE|VERIFY|REJECT|MERGE
  objectType String   @map("object_type") // entity|fact|relationship|alias|mention
  objectId   String   @map("object_id")
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  allowed    Boolean  @default(true)
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId], map: "agent_write_audits_run_idx")
  @@index([objectType, objectId], map: "agent_write_audits_object_idx")
  @@map("agent_write_audits")
}

// =============================================================================
// 审核域：自检报告 + 合并建议（适配实体）
// =============================================================================

/// @db.remark: 自检报告。记录章节/全书级别的结构化质量检查结果。issues 内每条可引用 entityId/factId。
model ValidationReport {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  jobId     String?  @map("job_id") @db.Uuid
  scope     String
  chapterId String?  @map("chapter_id") @db.Uuid
  status    String   @default("PENDING")
  issues    Json     @db.JsonB
  summary   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  book Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  job  AnalysisJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([bookId], map: "validation_book_idx")
  @@index([bookId, chapterId], map: "validation_book_chapter_idx")
  @@index([jobId], map: "validation_job_idx")
  @@map("validation_reports")
}

/// @db.remark: 实体合并建议。用于管理员审核同名/别名归并。接受后执行 mergeEntitiesInTransaction。
model MergeSuggestion {
  id             String    @id @default(uuid()) @db.Uuid
  bookId         String    @map("book_id") @db.Uuid
  sourceEntityId String    @map("source_entity_id") @db.Uuid
  targetEntityId String    @map("target_entity_id") @db.Uuid
  reason         String    @db.Text
  confidence     Float     @default(0)
  evidenceRefs   Json?     @map("evidence_refs")
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  source Entity @relation("MergeSuggestionSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  target Entity @relation("MergeSuggestionTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([bookId, status], map: "merge_suggestions_book_status_idx")
  @@index([sourceEntityId], map: "merge_suggestions_source_idx")
  @@index([targetEntityId], map: "merge_suggestions_target_idx")
  @@map("merge_suggestions")
}

// =============================================================================
// 运行域：AI 阶段调用日志
// =============================================================================

/// @db.remark: AI 阶段调用日志。记录每次调用模型、耗时、token 及 fallback 信息。
model AnalysisPhaseLog {
  id               String   @id @default(uuid()) @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  chapterId        String?  @map("chapter_id") @db.Uuid
  stage            String
  modelId          String?  @map("model_id") @db.Uuid
  modelSource      String   @map("model_source")
  isFallback       Boolean  @default(false) @map("is_fallback")
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  durationMs       Int?     @map("duration_ms")
  status           String
  errorMessage     String?  @map("error_message")
  chunkIndex       Int?     @map("chunk_index")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job     AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  model   AiModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)
  chapter Chapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([jobId, stage], map: "analysis_phase_logs_job_stage_idx")
  @@index([modelId], map: "analysis_phase_logs_model_idx")
  @@index([createdAt], map: "analysis_phase_logs_created_at_idx")
  @@map("analysis_phase_logs")
}

